{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "stage": "next build && next start -p 3001",
    "tokens:build": "node packages/design-system/src/build-tokens.mjs",
    "predev": "npm run tokens:build",
    "prebuild": "npm run tokens:build",
    "prestage": "npm run tokens:build",
    "lint": "eslint",
    "test": "node --test lib/**/*.test.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "verify": "bash scripts/verify.sh",
    "verify:full": "bash scripts/verify.sh --full",
    "test:e2e": "playwright test",
    "test:e2e:design-system": "playwright test --config=playwright.design-system.config.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "drizzle-orm": "^0.45.2",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
