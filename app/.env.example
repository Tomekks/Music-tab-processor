# PostHog's browser project key. This is intentionally public, not a secret.
NEXT_PUBLIC_POSTHOG_KEY=

# Use https://eu.i.posthog.com instead if your PostHog project is in the EU region.
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Optional. Spotify Web API (Client Credentials flow, app/lib/spotify.ts) --
# app-only access to public catalog data (search, track/artist metadata,
# album art), no per-user login. Get these from
# https://developer.spotify.com/dashboard after registering an app. Leaving
# both unset is fine: getTrackMetadata() short-circuits to null, no error,
# no network call -- the app falls back to today's placeholder cover art.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
